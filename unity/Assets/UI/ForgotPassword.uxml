<?xml version="1.0" encoding="utf-8"?>
<!-- パスワード再発行画面 (Web版 map画面/html/forgot_password.html の移植) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <Style src="Common.uss" />

    <ui:VisualElement class="screen">

        <ui:VisualElement class="app-header">
            <ui:Button name="back-button" text="＜ 戻る" class="app-header__back" />
            <ui:Label text="パスワード再発行" class="app-header__title" />
        </ui:VisualElement>

        <ui:VisualElement class="content content--wide">

            <ui:VisualElement class="instruction">
                <ui:Label text="名前とメールアドレスを入力してください。" class="instruction__text" />
            </ui:VisualElement>

            <ui:VisualElement class="form-group">
                <ui:Label text="名前" class="form-label" />
                <ui:TextField name="username-field" class="text-input" />
            </ui:VisualElement>

            <ui:VisualElement class="form-group">
                <ui:Label text="メールアドレス" class="form-label" />
                <ui:TextField name="email-field" class="text-input" />
            </ui:VisualElement>

            <ui:Button name="submit-button" text="パスワード再発行" class="primary-button" />

        </ui:VisualElement>

        <!-- 送信完了モーダル。既定では非表示にしてC#側で表示を切り替える -->
        <ui:VisualElement name="completion-modal" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-content">
                <ui:Label text="パスワード再発行" class="modal-title" />
                <ui:Label text="ご入力いただいたメールアドレスに再発行のメールを送信しますのでメールをご確認ください。" class="modal-text" />
                <ui:Button name="modal-close-button" text="閉じる" class="muted-button" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
