<?xml version="1.0" encoding="utf-8"?>
<!-- お問い合わせ (Web版 map画面/html/information.html の移植) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <Style src="Common.uss" />
    <Style src="Sheet.uss" />

    <ui:VisualElement class="screen sheet-screen">

        <!-- 入力画面 -->
        <ui:ScrollView name="form-page" class="sheet-scroll">
            <ui:VisualElement class="sheet-card">

                <ui:Button name="close-button" text="✕" class="close-x-button" />
                <ui:Label text="お問い合わせ" class="sheet-title" />
                <ui:Label text="不具合・ご意見・ご要望などをご入力ください。" class="description" />

                <ui:VisualElement class="divider" />

                <ui:Label text="お問い合わせ内容" class="sheet-label" />
                <ui:TextField name="contact-text-field" multiline="true" class="text-input textarea" />

                <ui:VisualElement class="divider" />

                <ui:Label text="画像" class="sheet-label" />
                <ui:Button name="select-image-button" text="画像を選択" class="muted-button" />
                <ui:Label text="※スクリーンショットなどがある場合は添付してください。" class="note" />

                <ui:Button name="send-button" text="送信する" class="primary-button sheet-action" />

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- 送信完了画面 -->
        <ui:VisualElement name="complete-page" class="sheet-scroll" style="display: none;">
            <ui:VisualElement class="sheet-card">

                <ui:Button name="complete-close-button" text="✕" class="close-x-button" />
                <ui:Label text="お問い合わせ送信完了" class="sheet-title" />

                <ui:Label text="お問い合わせいただき、ありがとうございました。&#10;&#10;運営で内容を確認後、必要に応じて返信いたします。&#10;&#10;今後も当アプリをご愛用いただけますと幸いです。" class="complete-text" />

                <ui:Button name="back-to-map-button" text="マップに戻る" class="primary-button" />

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
