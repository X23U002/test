/* =========================================================
   ログイン画面のスタイル
   Web版 map画面/css/login.css の移植。
   共通部分 (.instruction / .form-group / .primary-button など) は
   Common.uss にあるので、ここは差分だけ。
   ========================================================= */

/* body { display:flex; justify-content:center; align-items:center; height:100vh }
   -> 100vh は flex-grow:1 (親いっぱい) で表現する */
.login-screen {
    justify-content: center;
    align-items: center;
}

/* .login-container
   box-shadow はUSSに無いため、薄い枠線で代用している。
   影が必須ならスライス画像を background-image にする方法もある */
.login-container {
    background-color: var(--color-surface);
    width: 90%;
    max-width: 340px;
    padding: 30px 20px;
    border-radius: var(--radius-card);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
}

/* text-align は -unity-text-align に置き換える */
.app-title {
    -unity-text-align: middle-center;
    color: var(--color-primary);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

/* login.css はフォームの余白が他画面より詰まっているので上書き */
.login-container .form-group {
    margin-bottom: 15px;
}

.login-container .form-label {
    margin-bottom: 5px;
}

.login-container .instruction {
    margin-bottom: 20px;
    padding: 10px;
}

/* .links { display:flex; justify-content:space-between } */
.links {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}
