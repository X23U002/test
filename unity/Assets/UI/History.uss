/* 履歴・ルート案内画面 (Web版 map画面/css/history.css の移植) */

.section-title--spaced {
    margin-top: 30px;
}

.timeline-container {
    background-color: var(--color-surface);
    padding: 20px;
    border-radius: var(--radius-card);
    margin-bottom: 20px;
}

.timeline-node {
    padding-left: 30px;
    padding-bottom: 20px;
}

.timeline-node--last {
    padding-bottom: 0;
}

/* Web版 .timeline-node::before (丸印) の代替。
   擬似要素が無いのでUXMLに実体を置き、position:absolute で重ねる */
.timeline-node__dot {
    position: absolute;
    left: 6px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-primary);
}

/* 現在地の強調。box-shadow の光彩は USS に無いため、
   枠線 (border) で同じ効果を出している */
.timeline-node__dot--current {
    background-color: var(--color-accent);
    border-width: 3px;
    border-color: rgba(243, 156, 18, 0.3);
    left: 3px;
    top: 1px;
}

/* Web版 .timeline-node::after (縦線) の代替。
   height: calc(100% - 10px) は USS でも calc() が使える */
.timeline-node__line {
    position: absolute;
    left: 11px;
    top: 16px;
    width: 2px;
    height: 100%;
    background-color: var(--color-border);
}

.timeline-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.timeline-time {
    font-size: 12px;
    color: var(--color-text-weak);
    margin-top: 4px;
}

/* .history-list { display:flex; flex-direction:column; gap:12px } */
.history-list {
    flex-direction: column;
}

.history-item {
    background-color: var(--color-surface);
    padding: 16px;
    border-radius: 10px;
    border-left-width: 5px;
    border-left-color: var(--color-primary);
    /* gap:12px の代替 */
    margin-bottom: 12px;
}

.history-route {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 6px;
    white-space: normal;
}

.history-date {
    font-size: 12px;
    color: var(--color-text-weak);
}
